{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "ES2018"],
    "strict": true,
    /* 迁移期开关：老代码是从 JS 原样搬来的，隐式 any 还没补完。
       第 4 步（拆完 views/settings）会把它改回 true 并逐一补标注。 */
    "noImplicitAny": true,
    /* 迁移期开关：老代码大量 catch (e) { e.message } 写法（从 JS 原样搬来），
       第 4 步收尾时改为 true 并补 (e as Error) 断言。 */
    "useUnknownInCatchVariables": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    /* 依赖装在仓库自己的 node_modules（`npm install` 会在根上建）：
       曾经的 ../../../../../ppd-ts-build 绝对回推只在作者机器上成立，克隆出去就找不到类型。 */
    "paths": {
      "obsidian": ["node_modules/obsidian"]
    },
    "typeRoots": ["node_modules/@types"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
